%global debug_package %{nil}
%undefine _missing_build_ids_terminate_build

Name: cri-tools
Version: @VERSION@
Release: 1%{?dist}
Summary: CLI and validation tools for Container Runtime Interface
License: Apache-2.0
URL: https://github.com/kubernetes-sigs/cri-tools
Source0: %{name}-%{version}.tar.gz
BuildRequires: golang
BuildRequires: make

%description
CLI and validation tools for interacting with a container runtime.

%prep
%setup -q

%build
make binaries

%install
install -D -m 0755 build/bin/linux/amd64/crictl %{buildroot}%{_bindir}/crictl
install -D -m 0755 build/bin/linux/amd64/critest %{buildroot}%{_bindir}/critest

%files
%license LICENSE
%{_bindir}/crictl
%{_bindir}/critest
